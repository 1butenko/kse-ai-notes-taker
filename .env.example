API_PORT=8000
# Absolute API base for links in downloaded notes; include any deployment path prefix.
PUBLIC_API_URL=http://localhost:8000
MOODLE_URL=https://teaching.kse.org.ua
MOODLE_TOKEN=
# Optional: enables syllabus transcription. Without it the API still starts.
OPENROUTER_API_KEY=

# Sign-in (web: Auth.js with Google; api: app/auth.py). See README "Sign-in".
# Signs the web's and the worker's calls to the API; the same value for web, api and worker.
# Generate with `openssl rand -base64 32`.
API_AUTH_SECRET=
# Admins: a lecturer's rights on every course, as JSON emails, e.g. ["a@kse.org.ua"].
PLATFORM_ADMINS=[]
# Test servers only: every signed-in user is an admin of every course. Keep false in production.
OPEN_COURSE_ACCESS=false
# Encrypts the web's session cookie (`npx auth secret` or `openssl rand -base64 32`).
AUTH_SECRET=
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application).
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Google Workspace domains that may sign in (the ID token's `hd` claim), comma-separated.
AUTH_ALLOWED_DOMAINS=kse.org.ua

# AI Note Taker (Moodle materials agent, runs in the worker)
# Aurora PostgreSQL (IAM auth) and S3. AWS credentials come from ~/.aws (`aws login`),
# mounted into the api and worker containers; set AWS_PROFILE to pick a non-default profile.
AWS_REGION=eu-central-1
S3_BUCKET=
DB_HOST=
DB_NAME=postgres
# NOTE_TAKER_MODEL=openai/gpt-5.5
# Langfuse Prompt Management; empty keys use the prompts/*.md files.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Trace every model call in Langfuse (user, session, tokens, cost). Attached PDFs are never sent;
# text prompts are, including the reading text the lecture-notes agent reads.
# LANGFUSE_TRACING=true
# Lecture-notes agent (visual notes); empty models use NOTE_TAKER_MODEL.
# LECTURE_NOTES_MODEL=
# LECTURE_NOTES_REVIEWER_MODEL=
# LECTURE_NOTES_MAX_CHARS=400000
# LECTURE_NOTES_MAX_RENDERS=12
# LECTURE_NOTES_CONCURRENCY=2
