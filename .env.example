API_PORT=8000
MOODLE_URL=https://teaching.kse.org.ua
MOODLE_TOKEN=
# Optional: enables syllabus transcription. Without it the API still starts.
OPENROUTER_API_KEY=

# Langfuse tracing (self-hosted in Docker, UI at http://localhost:3001).
# `make langfuse-env` fills these with random secrets; tracing is off without the keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3001
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
