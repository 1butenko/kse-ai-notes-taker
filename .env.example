# NOTES_SELECTOR_MODEL=openai/gpt-6-luna
# NOTES_WRITER_MODEL=google/gemini-3.7-flash
# NOTES_VERIFIER_MODEL=openai/gpt-6-luna
# NOTES_ESCALATION_MODEL=openai/gpt-6.1-sol
