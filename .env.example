API_PORT=8000
# Absolute API base for links in downloaded notes; include any deployment path prefix.
PUBLIC_API_URL=http://localhost:8000
MOODLE_URL=https://teaching.kse.org.ua
MOODLE_TOKEN=
# Optional: enables syllabus transcription. Without it the API still starts.
OPENROUTER_API_KEY=

# AI Note Taker (Moodle materials agent, runs in the worker)
# Aurora PostgreSQL (IAM auth) and S3. AWS credentials come from ~/.aws (`aws login`),
# mounted into the api and worker containers; set AWS_PROFILE to pick a non-default profile.
AWS_REGION=eu-central-1
S3_BUCKET=
DB_HOST=
DB_NAME=postgres
# NOTE_TAKER_MODEL=openai/gpt-5.5
# Langfuse Prompt Management; empty keys use the prompts/*.md files.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Trace lecture-notes runs in Langfuse; traces include the reading text the agent read.
# LANGFUSE_TRACING=true
# Lecture-notes agent (visual notes); empty models use NOTE_TAKER_MODEL.
# LECTURE_NOTES_MODEL=
# LECTURE_NOTES_REVIEWER_MODEL=
# LECTURE_NOTES_MAX_CHARS=400000
# LECTURE_NOTES_MAX_RENDERS=12
# LECTURE_NOTES_CONCURRENCY=2
